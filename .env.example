NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=https://argadaagdo.ge
NEXT_PUBLIC_APP_VERSION=local

# Server-only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TBC_CLIENT_ID=your-tbc-client-id
TBC_CLIENT_SECRET=your-tbc-client-secret
TBC_API_KEY=your-tbc-developer-portal-apikey
TBC_CALLBACK_SECRET=use-a-long-random-callback-secret
# Optional: TBC_API_BASE_URL=https://api.tbcbank.ge/v1
# Set to true only once TBC has activated split payments for the merchant.
# TBC_SPLIT_ENABLED=false

# Transactional email delivery. Configure Resend and verify the sender domain
# before production launch.
RESEND_API_KEY=re_your_resend_api_key
TRANSACTIONAL_EMAIL_FROM="ArGadaagdo <support@argadaagdo.ge>"
TRANSACTIONAL_EMAIL_REPLY_TO=support@argadaagdo.ge
TRANSACTIONAL_EMAILS_ENABLED=true

# Used by Vercel Cron for pickup reminder emails.
CRON_SECRET=use-a-long-random-cron-secret

# Optional. When set, pass Authorization: Bearer <secret> to /api/health for
# detailed operational health output.
HEALTH_CHECK_SECRET=use-a-long-random-health-secret

# Business area on its own host, e.g. https://business.argadaagdo.ge.
# Leave empty until that domain is live: everything then stays on one host.
NEXT_PUBLIC_BUSINESS_SITE_URL=

# SMS codes, sent through Supabase's Send SMS hook (/api/auth/send-sms).
# The secret is shown by Supabase when the hook is created (v1,whsec_...).
SEND_SMS_HOOK_SECRET=
UBILL_API_KEY=
UBILL_BRAND_ID=

# Push notifications (lib/push/send.ts). Each half does nothing until set.
# iOS (APNs): the .p8 key's contents, its Key ID and the Apple team ID.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=9TVP238KLC
# Android (FCM): the Firebase service account key file's JSON, on one line.
FCM_SERVICE_ACCOUNT_JSON=
# First Android versionCode built with google-services.json. Until set, the
# Android app shows no notification switch (registering without Firebase crashes).
NEXT_PUBLIC_ANDROID_PUSH_MIN_BUILD=
# Optional social profiles (handles without @), see lib/appLinks.ts. Instagram
# defaults to ar_gadaagdo_app; the X link is hidden unless a handle is set.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_X_HANDLE=
