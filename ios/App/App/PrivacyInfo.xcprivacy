<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App privacy manifest (check-2 #9, 2026-11-07). Keep in sync with the App
  Store privacy answers in docs/app-store-submission.md.
  Required-reason APIs: @capacitor/filesystem reads file timestamps inside the
  app container (C617.1); Capacitor stores app settings in UserDefaults (CA92.1).
-->
